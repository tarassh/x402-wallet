{
  "name": "x402-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal x402 agentic wallet MCP server with Keychain and Ledger signer support.",
  "bin": {
    "x402-wallet": "./src/cli/main.ts",
    "x402-wallet-mcp": "./src/mcp/server.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/mcp/server.ts",
    "cli": "bun run src/cli/main.ts",
    "setup": "bash setup.sh",
    "install-mcp": "bash scripts/install-mcp.sh",
    "build-touchid": "bash scripts/build-touchid-approver.sh"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@napi-rs/keyring": "^1.2.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
